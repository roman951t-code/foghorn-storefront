{
	"name": "online-store",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=20.9.0"
	},
	"scripts": {
		"dev": "next dev",
		"build": "npx prisma db seed && next build",
		"start": "next start",
		"postinstall": "prisma generate && npm run chakra:typegen",
		"chakra:typegen": "chakra typegen ./src/styles/chakraTheme.ts",
		"predev": "npm run db:generate",
		"start:local:build": "npm run build && npm run start",
		"preview:mobile": "node scripts/preview-mobile.cjs",
		"typecheck": "npx tsc --noEmit",
		"lint:eslint": "eslint . --cache --cache-location .next/cache/eslint/",
		"lint": "npm run lint:eslint && npm run typecheck",
		"test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.mts\"",
		"test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\" \"src/**/*.test.mts\"",
		"setup:local": "npm install --legacy-peer-deps && npm run db:generate && tsx scripts/prisma-setup-local.ts && npm run db:generate && npm run clean:next",
		"clean:next": "rm -rf .next",
		"db:generate": "npx prisma generate",
		"db:migrate:dev": "npx prisma migrate dev && npx prisma generate",
		"db:migrate:deploy": "npx prisma migrate deploy && npx prisma generate",
		"db:migrate:baseline-existing": "npx prisma migrate resolve --applied 20260212130000_init",
		"db:push:dev": "npx prisma db push && npx prisma generate",
		"db:backfill:i18n": "tsx scripts/backfill-localized-content.ts",
		"db:backfill:i18n:overwrite": "tsx scripts/backfill-localized-content.ts --overwrite",
		"db:seed": "npm run db:migrate:deploy && npx prisma db seed",
		"db:backup-restore:drill": "RUN_DB_DRILL=true ./scripts/db-backup-restore-drill.sh",
		"cache:revalidate:windows": "tsx scripts/revalidate-window-boundaries.ts",
		"profile:search": "node --loader ts-node/esm scripts/profile-search.ts",
		"perf:load": "tsx scripts/load-test.ts",
		"admin:dev": "node --import tsx/esm -e \"process.env.NODE_ENV='development'; import('./src/admin/server.mts')\"",
		"admin:start": "node --import tsx/esm -e \"process.env.NODE_ENV='production'; process.env.ADMIN_JS_TMP_DIR='adminjs-bundle'; process.stderr.write('[admin:start] node -e begin\\n'); import('./src/admin/server.mts').catch(e=>{process.stderr.write('[admin:start] server.mts import failed: '+(e&&e.stack||e)+'\\n');process.exit(1);})\"",
		"admin:bundle": "NODE_ENV=production node --max-old-space-size=2048 --import tsx/esm scripts/admin-prebundle.mts",
		"render:build": "npm install --legacy-peer-deps --include=dev && npm run admin:bundle",
		"seed:content": "node scripts/seed-content-pages.cjs",
		"prepare": "husky"
	},
	"dependencies": {
		"@adminjs/design-system": "^4.1.1",
		"@adminjs/express": "6.1.1",
		"@adminjs/prisma": "5.0.4",
		"@chakra-ui/react": "3.35.0",
		"@emotion/cache": "^11.14.0",
		"@emotion/react": "^11.14.0",
		"@hookform/resolvers": "^5.2.2",
		"@next/bundle-analyzer": "^16.2.6",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@prisma/config": "^7.8.0",
		"@sentry/nextjs": "^10.53.1",
		"@sentry/node": "^10.53.1",
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.108.2",
		"adminjs": "7.8.17",
		"baseline-browser-mapping": "^2.10.43",
		"better-auth": "^1.6.11",
		"caniuse-lite": "^1.0.30001805",
		"cloudinary": "^2.10.0",
		"dotenv": "17.4.2",
		"express": "5.2.1",
		"express-formidable": "1.2.0",
		"express-session": "1.19.0",
		"helmet": "^8.1.0",
		"i18next": "^22.5.1",
		"nanoid": "^5.1.11",
		"next": "^16.2.6",
		"next-intl": "^4.12.0",
		"pg": "^8.21.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"qs": "^6.15.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-hook-form": "^7.76.0",
		"react-icons": "^5.6.0",
		"react-router": "^6.30.3",
		"react-use": "^17.6.0",
		"resend": "^6.12.3",
		"server-only": "^0.0.1",
		"slugify": "^1.6.9",
		"stripe": "^22.1.1",
		"swiper": "^12.1.4",
		"tslib": "2.8.1",
		"xlsx": "^0.18.5",
		"zod": "^4.4.3",
		"zustand": "^5.0.13"
	},
	"devDependencies": {
		"@chakra-ui/cli": "^3.36.0",
		"@faker-js/faker": "^10.4.0",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/node": "^25.9.0",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.39.4",
		"eslint-config-next": "16.2.6",
		"husky": "^9.1.7",
		"prisma": "^7.8.0",
		"ts-node": "^10.9.2",
		"tsx": "4.22.2",
		"typescript": "~5.9.3"
	}
}
