{
	"name": "online-store",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "npx tsc --noEmit",
		"lint:eslint": "eslint . --cache --cache-location .next/cache/eslint/",
		"lint": "npm run lint:eslint && npm run typecheck",
		"test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.mts\"",
		"test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\" \"src/**/*.test.mts\"",
		"db:migrate:dev": "npx prisma migrate dev && npx prisma generate",
		"db:migrate:deploy": "npx prisma migrate deploy && npx prisma generate",
		"db:migrate:baseline-existing": "npx prisma migrate resolve --applied 20260212130000_init",
		"db:push:dev": "npx prisma db push && npx prisma generate",
		"db:backfill:i18n": "tsx scripts/backfill-localized-content.ts",
		"db:backfill:i18n:overwrite": "tsx scripts/backfill-localized-content.ts --overwrite",
		"db:seed": "npm run db:migrate:deploy && npx prisma db seed",
		"db:backup-restore:drill": "RUN_DB_DRILL=true ./scripts/db-backup-restore-drill.sh",
		"cache:revalidate:windows": "tsx scripts/revalidate-window-boundaries.ts",
		"profile:search": "node --loader ts-node/esm scripts/profile-search.ts",
		"perf:load": "tsx scripts/load-test.ts",
		"admin:dev": "NODE_ENV=development node --import tsx/esm src/admin/server.mts",
		"admin:start": "NODE_ENV=production node --import tsx/esm src/admin/server.mts",
		"seed:content": "node scripts/seed-content-pages.cjs"
	},
	"prisma": {
		"seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
	},
	"dependencies": {
		"@adminjs/express": "6.1.1",
		"@adminjs/prisma": "5.0.4",
		"@adminjs/themes": "^1.0.1",
		"@chakra-ui/react": "3.30.0",
		"@emotion/react": "^11.14.0",
		"@formatjs/intl-localematcher": "^0.7.3",
		"@hookform/resolvers": "^5.2.2",
		"@next/bundle-analyzer": "^16.1.1",
		"@prisma/adapter-pg": "^6.19.1",
		"@prisma/client": "^6.19.1",
		"@stripe/stripe-js": "^8.6.0",
		"@types/lodash.pick": "^4.4.9",
		"adminjs": "7.8.17",
		"bcryptjs": "^3.0.3",
		"better-auth": "^1.4.9",
		"date-fns": "^4.1.0",
		"dotenv": "17.2.3",
		"express": "4.18.2",
		"express-formidable": "1.2.0",
		"express-session": "1.17.3",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.3",
		"lodash.pick": "^4.4.0",
		"nanoid": "^5.1.6",
		"next": "^16.1.1",
		"next-intl": "^4.6.1",
		"next-themes": "^0.4.6",
		"pg": "^8.16.3",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-hook-form": "^7.69.0",
		"react-icons": "^5.5.0",
		"react-use": "^17.6.0",
		"resend": "^6.6.0",
		"slugify": "^1.6.6",
		"stripe": "^20.1.0",
		"styled-components": "^6.1.19",
		"swiper": "^12.0.3",
		"tslib": "2.8.1",
		"uuid": "^13.0.0",
		"zod": "^4.2.1",
		"zustand": "^5.0.9"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.1.0",
		"@types/express": "^4.17.21",
		"@types/express-session": "^1.17.11",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.0.3",
		"@types/pg": "^8.16.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"baseline-browser-mapping": "^2.9.11",
		"eslint": "^9.39.2",
		"eslint-config-next": "16.1.1",
		"prisma": "^6.19.1",
		"ts-node": "^10.9.2",
		"tsx": "4.21.0",
		"typescript": "^5.9.3"
	}
}
