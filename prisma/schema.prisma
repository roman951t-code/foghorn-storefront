generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id
  name               String
  middleName         String?
  lastName           String?
  notificationMethod String?    @default("email")
  email              String     @unique
  emailVerified      Boolean
  image              String?
  createdAt          DateTime
  updatedAt          DateTime
  orders             Order[]
  accounts           Account[]
  sessions           Session[]
  wishlist           Wishlist[]
  reviews            Review[]

  phoneNumber         String?
  phoneNumberVerified Boolean?

  @@unique([phoneNumber])
  @@map("user")
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  logoUrl  String?
  products Product[]
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model ProductCategory {
  id       String            @id @default(uuid())
  name     String
  slug     String            @unique
  parentId String?
  parent   ProductCategory?  @relation("Subcategories", fields: [parentId], references: [id])
  children ProductCategory[] @relation("Subcategories")
  products Product[]
}

model Product {
  id           String                  @id @default(uuid())
  name         String
  description  String?
  slug         String                  @unique
  imageUrl     String?
  basePrice     Decimal @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  productCode   String
  stock        Int
  inStock      Boolean  @default(true)
  brandId      String
  averageRating  Float    @default(0)
  reviewCount    Int      @default(0)
  tags         String[]
  categoryId   String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  brand        Brand                   @relation(fields: [brandId], references: [id])
  category     ProductCategory         @relation(fields: [categoryId], references: [id])
  attributes   ProductAttributeValue[]
  variants     ProductVariant[]
  orderItems   OrderItem[]
  wishlistedBy Wishlist[]
  reviews      Review[]
}

model ProductAttribute {
  id       String                  @id @default(uuid())
  name     String                  @unique
  unit     String?
  products ProductAttributeValue[]
}

model ProductAttributeValue {
  id           String           @id @default(uuid())
  productId    String
  attributeId  String
  value        String

  product      Product          @relation(fields: [productId], references: [id])
  attribute    ProductAttribute @relation(fields: [attributeId], references: [id])
}


model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  name       String
  price      Decimal     @db.Decimal(10, 2)
  stock      Int
  sku        String      @unique
  imageUrl   String?
  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[] @relation("OrderVariantRelation")
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  total     Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  price     Decimal         @db.Decimal(10, 2)
  unitPrice Decimal         @db.Decimal(10, 2)
  order     Order           @relation(fields: [orderId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation("OrderVariantRelation", fields: [variantId], references: [id])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}
