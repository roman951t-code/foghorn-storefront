# NEVER put real values in this file. It is committed to git.
# Real values go in .env.local (dev) or the hosting provider's env settings (prod).

# Core application
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
NEXT_PUBLIC_APP_URL=https://shop.example.com
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ENCRYPTION_KEY=replace-with-64-char-hex-key

# Storefront security and cache revalidation
CACHE_REVALIDATE_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-separate-long-random-secret
UPSTASH_REDIS_REST_URL=https://YOUR-UPSTASH-INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
ALLOWED_APP_HOSTS=shop.example.com

# Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM=Online Store <orders@example.com>

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=usd

# Optional auth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Optional observability / alerting
CACHE_REVALIDATE_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_URL=
SENTRY_DSN=https://PUBLIC_KEY@o000000.ingest.sentry.io/000000
NEXT_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@o000000.ingest.sentry.io/000000
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.02
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# AdminJS runtime (deploy separately from the Vercel storefront)
ADMINJS_EMAIL=admin@example.com
ADMINJS_PASSWORD=replace-with-a-strong-password
ADMINJS_READONLY_EMAIL=readonly@example.com
ADMINJS_READONLY_PASSWORD=replace-with-a-strong-readonly-password
ADMINJS_SESSION_SECRET=replace-with-a-long-random-secret
ADMINJS_COOKIE_PASSWORD=replace-with-a-long-random-secret
ADMINJS_PUBLIC_URL=https://admin.example.com/admin
ADMINJS_ALLOWED_IPS=
ADMINJS_ALLOWED_ORIGINS=https://admin.example.com,https://shop.example.com
ADMIN_LOG_LEVEL=info
ADMIN_SENTRY_DSN=https://PUBLIC_KEY@o000000.ingest.sentry.io/000000
ADMIN_SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional media / upload integrations
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_UPLOAD_FOLDER=store

# Supabase (JS client — for real-time, storage, or direct Supabase API access)
# These are public/publishable values; safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
