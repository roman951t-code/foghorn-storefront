# AdminJS env vars — set these in Render → Service → Environment
# Copy this file, fill in real values, and never commit the filled-in version.

# ── Database (same Supabase instance as storefront) ───────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# ── Admin credentials ─────────────────────────────────────────────────────────
ADMINJS_EMAIL=admin@example.com
ADMINJS_PASSWORD=replace-with-a-strong-password
ADMINJS_READONLY_EMAIL=readonly@example.com
ADMINJS_READONLY_PASSWORD=replace-with-a-strong-readonly-password

# ── Session / cookie security ─────────────────────────────────────────────────
# Both secrets must be at least 32 characters. Use different values for each.
ADMINJS_SESSION_SECRET=replace-with-a-long-random-secret
ADMINJS_COOKIE_PASSWORD=replace-with-a-different-long-random-secret

# ── Network access ────────────────────────────────────────────────────────────
# Public URL where the admin panel is served (used for CORS and redirects)
ADMINJS_PUBLIC_URL=https://admin.example.com/admin
# Comma-separated list of IPs allowed to access the panel (empty = allow all)
ADMINJS_ALLOWED_IPS=
# Comma-separated list of origins allowed by CORS
ADMINJS_ALLOWED_ORIGINS=https://admin.example.com,https://shop.example.com

# ── Media (Cloudinary) ────────────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_UPLOAD_FOLDER=store

# ── Observability ─────────────────────────────────────────────────────────────
ADMIN_LOG_LEVEL=info
ADMIN_SENTRY_DSN=https://PUBLIC_KEY@o000000.ingest.sentry.io/000000
ADMIN_SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── AdminJS component bundling (Render free tier) ─────────────────────────────
# REQUIRED or the service OOMs bundling components at boot / 404s the admin UI.
# See docs/cicd-pipeline.md "AdminJS bundling" section before touching these.
ADMIN_JS_SKIP_BUNDLE=true
ADMIN_JS_TMP_DIR=adminjs-bundle
