{
	"compilerOptions": {
		"baseUrl": "src/",
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"],
			"@/styles/*": ["styles/*"],
			"@/components/*": ["components/*"],
			"@/assets/*": ["assets/*"],
			"@/i18n/*": ["i18n/*"],
			"@/data/*": ["data/*"],
			"@/types/*": ["types/*"],
			"@/utils/*": ["utils/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		"src/styles/chakraTheme.js"
	],
	"exclude": ["node_modules"]
}
